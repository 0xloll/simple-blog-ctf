<!doctype html><html><head><title>Comment History</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav') %><main class="narrow"><h1>Comment History</h1><p class="muted">Previous versions of this comment.</p><% history.forEach(revision => { %><div class="card"><small>Revision <%= revision.revision_number %> · <%= revision.created_at %></small><p><%= revision.body %></p></div><% }) %><a href="/posts/<%= comment.post_id %>">Back to post</a></main></body></html>
